{
  "servers": {
    "luau-lsp": {
      "command": "luau-lsp",
      "args": ["lsp", "--definitions=@tern=types/tern.d.luau"],
      "fileTypes": [".luau"],
      "languageId": "luau",
      "rootMarkers": ["plugin.toml"],
      "settings": {
